{
  "name": "wedding-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "vitest run --passWithNoTests --config tests/integration/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run generate -w @wedding/database",
    "db:validate": "npm run validate -w @wedding/database",
    "db:migrate:dev": "npm run migrate:dev -w @wedding/database",
    "validate:repo": "node scripts/validate-repository.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate:deploy": "npm run migrate:deploy -w @wedding/database"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.5.0"
}
