generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") directUrl = env("DIRECT_URL") }

enum UserStatus { ACTIVE SUSPENDED DELETED }
enum MemberRole { OWNER EDITOR VIEWER FINANCE SUPPORT ADMIN VENDOR_OPERATOR RESELLER }
enum InvitationStatus { DRAFT READY PUBLISHED PAUSED EXPIRED ARCHIVED }
enum OrderStatus { DRAFT PENDING_PAYMENT PAID FULFILLING COMPLETED CANCELLED REFUNDED }
enum PaymentStatus { CREATED PENDING PAID FAILED EXPIRED REFUND_PENDING REFUNDED PARTIALLY_REFUNDED }
enum RsvpResponse { ATTENDING DECLINED TENTATIVE }
enum MediaState { PENDING_UPLOAD UPLOADED SCANNING PROCESSING READY REJECTED DELETED }
enum VendorStatus { DRAFT PENDING_VERIFICATION VERIFIED SUSPENDED }
enum PrintingStatus { DRAFT QUOTED PAID PROOF_PENDING PROOF_APPROVED PRODUCTION SHIPPED COMPLETED CANCELLED }
enum NotificationStatus { QUEUED SENT DELIVERED FAILED SUPPRESSED }

model Tenant { id String @id @default(uuid()) name String @db.VarChar(150) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt memberships TenantMembership[] weddings Wedding[] vendors Vendor[] orders Order[] @@index([createdAt]) }
model User { id String @id @default(uuid()) email String @unique @db.VarChar(320) displayName String @db.VarChar(150) status UserStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt memberships TenantMembership[] orders Order[] auditEvents AuditEvent[] }
model TenantMembership { id String @id @default(uuid()) tenantId String userId String role MemberRole status String @default("ACTIVE") tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict) user User @relation(fields:[userId],references:[id],onDelete:Restrict) @@unique([tenantId,userId,role]) @@index([userId,status]) }
model Wedding { id String @id @default(uuid()) tenantId String displayName String @db.VarChar(150) weddingDate DateTime? @db.Date timezone String @default("Asia/Jakarta") locale String @default("id-ID") currency String @default("IDR") status String @default("DRAFT") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict) events WeddingEvent[] invitation Invitation? households GuestHousehold[] media MediaAsset[] orders Order[] printingOrders PrintingOrder[] @@index([tenantId,status]) }
model WeddingEvent { id String @id @default(uuid()) tenantId String weddingId String title String @db.VarChar(150) eventType String startsAt DateTime endsAt DateTime? timezone String venueName String? addressSnapshot String? mapUrl String? displayOrder Int @default(0) wedding Wedding @relation(fields:[weddingId],references:[id],onDelete:Restrict) rsvps Rsvp[] @@unique([weddingId,displayOrder]) @@index([tenantId,weddingId,startsAt]) }
model Template { id String version String name String category String tier String manifest Json status String @default("DRAFT") licenseStatus String @default("UNVERIFIED") createdAt DateTime @default(now()) invitations Invitation[] @@id([id,version]) @@index([status,tier]) }
model Invitation { id String @id @default(uuid()) tenantId String weddingId String @unique templateId String templateVersion String slug String @unique status InvitationStatus @default(DRAFT) draftConfig Json optimisticVersion Int @default(1) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt wedding Wedding @relation(fields:[weddingId],references:[id],onDelete:Restrict) template Template @relation(fields:[templateId,templateVersion],references:[id,version],onDelete:Restrict) publications InvitationPublication[] customDomains CustomDomain[] @@index([tenantId,status]) }
model InvitationPublication { id String @id @default(uuid()) tenantId String invitationId String publicationVersion Int snapshot Json templateId String templateVersion String contractVersion Int active Boolean @default(false) publishedBy String publishedAt DateTime @default(now()) invitation Invitation @relation(fields:[invitationId],references:[id],onDelete:Restrict) @@unique([invitationId,publicationVersion]) @@index([tenantId,invitationId,active]) }
model GuestHousehold { id String @id @default(uuid()) tenantId String weddingId String displayName String @db.VarChar(200) phoneEncrypted String? phoneHash String? emailEncrypted String? emailHash String? maximumPax Int @default(1) tokenHash String @unique tokenVersion Int @default(1) status String @default("ACTIVE") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt wedding Wedding @relation(fields:[weddingId],references:[id],onDelete:Restrict) guests Guest[] rsvps Rsvp[] guestbookMessages GuestbookMessage[] @@index([tenantId,weddingId,status]) @@index([weddingId,phoneHash]) @@index([weddingId,emailHash]) }
model Guest { id String @id @default(uuid()) tenantId String householdId String displayName String @db.VarChar(200) category String @default("ADULT") status String @default("ACTIVE") household GuestHousehold @relation(fields:[householdId],references:[id],onDelete:Restrict) @@index([tenantId,householdId]) }
model Rsvp { id String @id @default(uuid()) tenantId String householdId String eventId String response RsvpResponse pax Int optimisticVersion Int @default(1) respondedAt DateTime @default(now()) updatedAt DateTime @updatedAt household GuestHousehold @relation(fields:[householdId],references:[id],onDelete:Restrict) event WeddingEvent @relation(fields:[eventId],references:[id],onDelete:Restrict) history RsvpHistory[] @@unique([householdId,eventId]) @@index([tenantId,eventId,response]) }
model RsvpHistory { id String @id @default(uuid()) tenantId String rsvpId String previousResponse RsvpResponse? newResponse RsvpResponse previousPax Int? newPax Int actorType String actorId String? changedAt DateTime @default(now()) rsvp Rsvp @relation(fields:[rsvpId],references:[id],onDelete:Restrict) @@index([tenantId,rsvpId,changedAt]) }
model GuestbookMessage { id String @id @default(uuid()) tenantId String weddingId String householdId String? displayName String message String moderationStatus String @default("PENDING") submittedAt DateTime @default(now()) household GuestHousehold? @relation(fields:[householdId],references:[id],onDelete:SetNull) @@index([tenantId,weddingId,moderationStatus,submittedAt]) }
model GiftAccount { id String @id @default(uuid()) tenantId String weddingId String provider String accountName String accountValueEncrypted String maskedValue String displayOrder Int status String @default("ACTIVE") @@index([tenantId,weddingId,status]) }
model MediaAsset { id String @id @default(uuid()) tenantId String weddingId String objectKey String @unique mediaType String state MediaState @default(PENDING_UPLOAD) mimeType String sizeBytes BigInt checksum String width Int? height Int? altText String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt wedding Wedding @relation(fields:[weddingId],references:[id],onDelete:Restrict) @@index([tenantId,weddingId,state]) @@index([checksum]) }
model Package { id String @id @default(uuid()) code String @unique name String status String limits Json prices Price[] }
model Price { id String @id @default(uuid()) packageId String currency String amountMinor BigInt billingPeriod String? activeFrom DateTime activeUntil DateTime? package Package @relation(fields:[packageId],references:[id],onDelete:Restrict) @@index([packageId,currency,activeFrom]) }
model Promotion { id String @id @default(uuid()) code String @unique status String startsAt DateTime endsAt DateTime usageLimit Int? configuration Json redemptions PromotionRedemption[] }
model PromotionRedemption { id String @id @default(uuid()) tenantId String promotionId String orderId String createdAt DateTime @default(now()) promotion Promotion @relation(fields:[promotionId],references:[id],onDelete:Restrict) @@unique([promotionId,orderId]) @@index([tenantId,createdAt]) }
model Order { id String @id @default(uuid()) tenantId String userId String weddingId String? orderNumber String @unique currency String subtotalMinor BigInt discountMinor BigInt taxMinor BigInt totalMinor BigInt status OrderStatus @default(DRAFT) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict) user User @relation(fields:[userId],references:[id],onDelete:Restrict) wedding Wedding? @relation(fields:[weddingId],references:[id],onDelete:Restrict) items OrderItem[] payments Payment[] @@index([tenantId,status,createdAt]) }
model OrderItem { id String @id @default(uuid()) tenantId String orderId String productType String productCode String descriptionSnapshot String unitPriceMinor BigInt quantity Int totalMinor BigInt configurationSnapshot Json order Order @relation(fields:[orderId],references:[id],onDelete:Restrict) entitlements Entitlement[] @@index([tenantId,orderId]) }
model Payment { id String @id @default(uuid()) tenantId String orderId String provider String providerTransactionId String providerEventId String? method String? amountMinor BigInt currency String status PaymentStatus @default(CREATED) paidAt DateTime? expiresAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt order Order @relation(fields:[orderId],references:[id],onDelete:Restrict) @@unique([provider,providerTransactionId]) @@unique([provider,providerEventId]) @@index([tenantId,orderId,status]) }
model Entitlement { id String @id @default(uuid()) tenantId String orderItemId String productCode String status String startsAt DateTime endsAt DateTime? limits Json orderItem OrderItem @relation(fields:[orderItemId],references:[id],onDelete:Restrict) @@index([tenantId,productCode,status]) }
model Subscription { id String @id @default(uuid()) tenantId String packageId String providerSubscriptionId String @unique status String currentPeriodStart DateTime currentPeriodEnd DateTime cancelAtPeriodEnd Boolean @default(false) @@index([tenantId,status,currentPeriodEnd]) }
model Vendor { id String @id @default(uuid()) tenantId String businessName String slug String @unique category String status VendorStatus @default(DRAFT) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict) printingOrders PrintingOrder[] @@index([status,category]) }
model PrintingOrder { id String @id @default(uuid()) tenantId String weddingId String vendorId String orderId String designPublicationId String? quantity Int specification Json proofObjectKey String? proofApprovedAt DateTime? status PrintingStatus @default(DRAFT) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt wedding Wedding @relation(fields:[weddingId],references:[id],onDelete:Restrict) vendor Vendor @relation(fields:[vendorId],references:[id],onDelete:Restrict) shipments Shipment[] @@index([tenantId,status,createdAt]) @@index([vendorId,status,createdAt]) }
model Shipment { id String @id @default(uuid()) tenantId String printingOrderId String provider String trackingNumber String? addressEncrypted String status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt printingOrder PrintingOrder @relation(fields:[printingOrderId],references:[id],onDelete:Restrict) @@index([tenantId,status]) @@index([provider,trackingNumber]) }
model Notification { id String @id @default(uuid()) tenantId String channel String templateCode String recipientRefEncrypted String idempotencyKey String @unique status NotificationStatus @default(QUEUED) providerMessageId String? scheduledAt DateTime? sentAt DateTime? createdAt DateTime @default(now()) @@index([tenantId,status,scheduledAt]) }
model CustomDomain { id String @id @default(uuid()) tenantId String invitationId String hostname String @unique verificationTokenHash String status String @default("PENDING_DNS") certificateStatus String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt invitation Invitation @relation(fields:[invitationId],references:[id],onDelete:Restrict) @@index([tenantId,status]) }
model Reseller { id String @id @default(uuid()) tenantId String code String @unique status String commissionPolicy Json createdAt DateTime @default(now()) @@index([tenantId,status]) }
model ModerationCase { id String @id @default(uuid()) tenantId String targetType String targetId String policyCode String status String @default("OPEN") assignedTo String? decision String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId,status,createdAt]) }
model AuditEvent { id String @id @default(uuid()) tenantId String? userId String? actorType String action String targetType String targetId String reason String? metadata Json correlationId String createdAt DateTime @default(now()) user User? @relation(fields:[userId],references:[id],onDelete:SetNull) @@index([tenantId,createdAt]) @@index([targetType,targetId]) @@index([correlationId]) }
model OutboxEvent { id String @id @default(uuid()) tenantId String? eventType String aggregateType String aggregateId String payload Json payloadVersion Int @default(1) status String @default("PENDING") attemptCount Int @default(0) availableAt DateTime @default(now()) processedAt DateTime? lastError String? createdAt DateTime @default(now()) @@index([status,availableAt]) @@index([aggregateType,aggregateId]) }
